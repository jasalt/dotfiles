#!/bin/bash
# Launch emacsclient or emacs passing args to it on Debian / MacOS.

# If having trouble on Mac, make sure correct emacsclient is found in $PATH.

if [ "$(pidof emacs)" ] ; then
    if [ $# -eq 0 ]; then
        emacsclient -c -s ~/.emacs.d/.cache/server/jarkon-emacs &
    else
	# TODO use -c conditionally depending if emacs has window on current virtual desktop 
        emacsclient -c -s ~/.emacs.d/.cache/server/jarkon-emacs "$@" &
    fi
else
    if [[ $OSTYPE == 'darwin'* ]]; then
        if [ $# -eq 0 ]; then
            open -a Emacs --args --chdir $PWD &
        else
            open -a Emacs --args --chdir $PWD "$@"
        fi
    else
        if [ $# -eq 0 ]; then
            emacs &
        else
            emacs "$@" &
        fi
    fi
fi
