# Sets Prezto options.

# Color output (automatically disabled on dumb terminals).
zstyle ':prezto:*:*' color 'yes'

# Load custom modules alongside the bundled modules.
zstyle ':prezto:load' pmodule-dirs $HOME/.zprezto/custom-modules

# Enabled modules. Order matters.
zstyle ':prezto:load' pmodule \
  'archive' \
  'command-not-found' \
  'git' \
  'environment' \
  'terminal' \
  'syntax-highlighting' \
  'editor' \
  'history' \
  'directory' \
  'utility' \
  'completion' \
  'history-substring-search' \
  'prompt' \
  'last-working-dir' \
  'autosuggestions'

# Keep directory tracking and manual lwd, without changing startup directories.
zstyle ':prezto:module:last-working-dir' auto-restore 'no'

# Emacs editing keys and repeated-dot expansion for parent directories.
zstyle ':prezto:module:editor' key-bindings 'emacs'
zstyle ':prezto:module:editor' dot-expansion 'yes'

# Match separated query fragments when searching history.
zstyle ':prezto:module:history-substring-search' fuzzy 'yes'

# Prompt theme.
zstyle ':prezto:module:prompt' theme 'sorin'

# Syntax highlighting layers.
zstyle ':prezto:module:syntax-highlighting' highlighters \
  'main' \
  'brackets' \
  'pattern' \
  'root'

# Use the terminal theme's gray for comments.
zstyle ':prezto:module:syntax-highlighting' styles \
  'comment' 'fg=8'
